<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Two Spoons | Potts Point</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4eee6;
      color: #1f1b17;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .page {
      width: 100%;
      max-width: 960px;
      text-align: center;
    }

    .location {
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin-bottom: 28px;
      color: #6f6257;
    }

    h1 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(64px, 13vw, 150px);
      line-height: 0.9;
      font-weight: 400;
      letter-spacing: -0.06em;
      margin-bottom: 32px;
    }

    .tagline {
      font-size: clamp(24px, 4vw, 44px);
      line-height: 1.05;
      max-width: 760px;
      margin: 0 auto 28px;
      font-weight: 600;
      letter-spacing: -0.04em;
    }

    .copy {
      font-size: 18px;
      line-height: 1.5;
      max-width: 560px;
      margin: 0 auto 44px;
      color: #4a4038;
    }

    .signup {
      display: flex;
      justify-content: center;
      gap: 10px;
      max-width: 520px;
      margin: 0 auto 36px;
    }

    input {
      flex: 1;
      padding: 16px 18px;
      border: 1px solid #1f1b17;
      background: transparent;
      font-size: 15px;
      color: #1f1b17;
      outline: none;
    }

    input::placeholder {
      color: #8a7b6d;
    }

    button {
      padding: 16px 22px;
      border: 1px solid #1f1b17;
      background: #1f1b17;
      color: #f4eee6;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    button:hover {
      background: transparent;
      color: #1f1b17;
    }

    .links {
      display: flex;
      justify-content: center;
      gap: 24px;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    a {
      color: #1f1b17;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
    }

    @media (max-width: 640px) {
      body {
        align-items: flex-start;
        padding-top: 72px;
      }

      .signup {
        flex-direction: column;
      }

      button, input {
        width: 100%;
      }

      .copy {
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <p class="location">Potts Point · Opening Soon</p>

    <h1>Two<br>Spoons</h1>

    <p class="tagline">
      </p>

    <p class="copy">
      Too heavy, too sweet, or never quite right. Two Spoons is a new gelato concept made with real ingredients, lighter options, and a reason to stay a little longer.
    </p>

    <form class="signup">
      <input type="email" placeholder="Email address" />
      <button type="submit">Be first</button>
    </form>

    <div class="links">
      <a href="https://www.instagram.com/" target="_blank">Instagram</a>
      <a href="mailto:hello@twospoons.com.au">Contact</a>
    </div>
  </main>
</body>
</html>
